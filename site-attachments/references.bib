@inproceedings{capaldiTimePlaceSustainable2025,
  title = {Time and {{Place}} for ({{Sustainable}}) {{Planning}}: {{A Structural Topic Model Analysis}} of {{Campus Master Plans}}},
  author = {Capaldi, Matthew J. and Shin, Jinnie},
  date = {2025-04-23},
  location = {Denver, CO},
  url = {https://convention2.allacademic.com/one/aera/aera25/online_program_direct_link/view_paper/2185762/},
  abstract = {A well­planned college campus can significantly impact an institutions’ finances, students, and sustainability efforts. Despite its importance, systematic research on campus master plans remains limited (Dalton et al., 2018). This paper addresses this gap by employing structural topic modeling to identify the main topics within the campus master plans, and to analyze how these topics’ prevalence varies across time and location. The results highlight sustainability collaboration as a dominant topic, showing a clear pattern of variation over time and place. These findings contribute to the literature by suggesting that the inconsistency in college sustainability efforts may be influenced by external environmental factors, thereby affecting administrative processes that are typically considered uncontroversial.},
  eventtitle = {{{AERA}}: {{American Educational Research Association}}}
}


@inproceedings{huTypologyStateMerit2023,
  title = {A Typology of State Merit Aid Programs for Community College Students},
  author = {Hu, Xiaodan and Fernandez, Frank and Qiu, Yuxi and Capaldi, Matthew J.},
  date = {2023-04-15},
  location = {Chicago, IL},
  url = {https://convention2.allacademic.com/one/aera/aera23/online_program_direct_link/view_paper/2005392/},
  abstract = {State-funded financial aid has increasingly used merit-based criteria to distribute its scholarships and grants, and the dominant conversation on merit-aid programs centers on students attending four-year colleges and universities. Using a novel dataset capturing a variety of features of state-funded merit-aid programs for all adopted states in the nation between 2003 and 2021, our study focuses on the characteristics of merit-aid programs for community college students. The findings indicate that there are three types of merit-aid programs for community college students: the balanced programs, the community college exclusion programs, and the community college targeted programs. We discuss the characteristics of these three programs and provide implications for designing merit-aid programs to better support community college students and promote educational equity.},
  eventtitle = {{{AERA}}: {{American Educational Research Association}}}
}

